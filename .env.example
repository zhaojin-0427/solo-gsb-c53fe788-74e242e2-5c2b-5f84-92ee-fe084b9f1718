# Copy to .env for local development (loaded automatically by the app).

# PostgreSQL DSN (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://webhook:webhook@localhost:5432/webhook

# Retry policy: 6 attempts, exponential backoff 1s,2s,4s,8s,16s (capped at 300s)
MAX_ATTEMPTS=6
BACKOFF_BASE_SECONDS=1
BACKOFF_MAX_SECONDS=300
BACKOFF_JITTER_RATIO=0.1
HTTP_TIMEOUT_SECONDS=10

# Worker lease
LEASE_TTL_SECONDS=30
POLL_INTERVAL_SECONDS=0.5
# WORKER_ID defaults to the hostname

# Receiver
RECEIVER_SECRET=whsec_dev_receiver_secret
RECEIVER_BEHAVIOR=ok
RECEIVER_TOLERANCE_SECONDS=300
RECEIVER_FLAKY_FAILS=2
